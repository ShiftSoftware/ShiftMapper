<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE SAMPLE'S STAND-IN FOR A FRAMEWORK PACKAGE, modelled on ShiftFramework: a library the sample
    consumes as a compiled assembly, the way a NuGet package is consumed.

    A source generator compiling the sample sees this assembly as METADATA — types, signatures,
    attributes, never a method body — so the CreateMap and CreateConversion calls in its mapper and
    pack are not there to read. That is why THIS project references the generator too (below): it
    writes the Map methods onto PlatformMapper, as it would for any mapper, AND writes this
    project's DECLARATIONS into the assembly as attributes, which is the only thing a consumer's
    generator can see. The expressions themselves arrive at run time, when the consumer includes or
    registers the mapper and its constructor runs.

    The package also REGISTERS ITSELF (ContosoPlatformServiceCollectionExtensions.cs): its own
    AddShiftMapper call registers its mapper and SHARES its pack, and the generator writes the share
    down too, so a consumer's build applies the pack to every mapper the consumer registers.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Contoso.Platform</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShiftMapper\ShiftMapper.csproj" />

    <!-- THE GENERATOR, referenced as an analyzer exactly as an application does. It generates
         PlatformMapper's own Map methods and writes this project's DECLARATIONS into the assembly
         as metadata, which is the only thing a generator compiling a CONSUMER can read. -->
    <ProjectReference Include="..\ShiftMapper.Generator\ShiftMapper.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
