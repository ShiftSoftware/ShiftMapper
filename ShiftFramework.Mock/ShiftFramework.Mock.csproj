<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A STAND-IN FOR SHIFTFRAMEWORK, and the point of it is what it does NOT reference.

    It has no analyzer reference and generates nothing. It is an ordinary library that the
    sample consumes as a compiled assembly — which is exactly the situation Step 13 exists for,
    because a source generator sees a referenced assembly as METADATA and metadata has no method
    bodies. Everything this project wants understood has to survive into attributes and signatures.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShiftFramework</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShiftMapper\ShiftMapper.csproj" />

    <!-- THE GENERATOR, referenced as an analyzer exactly as an application does. It does not write
         a mapper for this project - there is none - it writes this project's DECLARATIONS into the
         assembly as metadata, which is the only thing a generator compiling a CONSUMER can read. -->
    <ProjectReference Include="..\ShiftMapper.Generator\ShiftMapper.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
