<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Source generators MUST target netstandard2.0: the C# compiler loads this
         assembly as a plugin, and the compiler itself runs on netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Lets Visual Studio attach a debugger to the generator. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Turns on the extra analyzer-authoring rules (e.g. "don't do file I/O in a
         generator"). Recommended for any analyzer/generator project. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn: the C# compiler API we use to read code and write new code.
         PrivateAssets="all" keeps it out of anything that references us. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
