<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 keeps this plugin loadable by compiler and IDE hosts.
         The Roslyn package version below separately sets the minimum compiler API version. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Lets Visual Studio attach a debugger to the generator. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Turns on the extra analyzer-authoring rules (e.g. "don't do file I/O in a
         generator"). Recommended for any analyzer/generator project. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn: the C# compiler API we use to read code and write new code.
         PrivateAssets="all" keeps it out of anything that references us. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Analyzer release tracking: a changelog of our diagnostic ids (SM0001, ...).
         Roslyn reads these as AdditionalFiles. Without them RS2008 asks us to enable
         release tracking; once enabled, RS2000/RS2001 flag ids missing from the list. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
