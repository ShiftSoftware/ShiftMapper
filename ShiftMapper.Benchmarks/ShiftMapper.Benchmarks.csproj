<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet refuses to run a Debug build, and it is right to: the numbers would
         be meaningless. See Program.cs for the command line. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The container: the mapper is resolved the way an application resolves it. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!--
      THE TWO THE PLAN NAMES. AutoMapper is pinned to 14.0.0, the last MIT release: 15.0 moved
      to a commercial licence with a LicenseKey setting, and a benchmark should not carry a
      "did you configure the licence" caveat. The engine is the same one - configuration read
      at run time, expression trees compiled on first use - which is the approach being measured.
      Bump the version below to compare against a newer one.
    -->
    <PackageReference Include="AutoMapper" Version="14.0.0" />

    <!-- Mapperly is a source generator too, so it is the comparison that matters most. -->
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShiftMapper\ShiftMapper.csproj" />

    <ProjectReference Include="..\ShiftMapper.Generator\ShiftMapper.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
